{
  "name": "dsh-wechat-usb",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "WeChat over USB: status/shot/open/send/watch/config tools with host-info guard, rate limits, and a graphical settings page.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realmuko/dsh-wechat-usb.git"
  },
  "bugs": {
    "url": "https://github.com/realmuko/dsh-wechat-usb/issues"
  },
  "homepage": "https://github.com/realmuko/dsh-wechat-usb#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wechat",
    "adb",
    "automation",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "skills",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "wechat-usb.config.example.json"
  ],
  "scripts": {
    "test": "node test/poller-selftest.mjs",
    "selftest": "node test/poller-selftest.mjs",
    "check": "node --check index.js && node --check client.js && node --check lib/core.js && node --check lib/poller.js && node --check lib/api.js && node --check lib/sessions.js",
    "cli": "node lib/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  }
}
